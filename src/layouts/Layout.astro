---
import Header from "@components/Header.astro";
import { getAbsoluteLocaleUrl } from "astro:i18n";
import { LOCALES, DEFAULT_LOCALE, settings, getContent, getUi } from "@i18n";
import { formatPrice, fillVariables } from "@lib/format";
import type { Locale } from "@types";

import "../styles/global.css";
import "../styles/sections.css";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const content = getContent(locale);
const ui = getUi(locale);
const { title, description } = content.home.seo;
const { author, socialImage, siteUrl, name, email, phone, whatsapp, socialLinks } = settings;

const canonicalURL = getAbsoluteLocaleUrl(locale, "");
const ogImgUrl = new URL(socialImage, siteUrl).href;

// Données structurées (SEO) : profil de la personne
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: author,
  alternateName: name,
  url: siteUrl,
  email: `mailto:${email}`,
  jobTitle: content.home.hero.specialty,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Lomé",
    addressCountry: "TG",
  },
  sameAs: socialLinks.map(({ href }) => href),
};

// Données lues par les scripts (terminal, animations) — issues du contenu éditable
const siteData = {
  locale,
  author,
  email,
  phone,
  whatsapp,
  specialty: content.home.hero.specialty,
  headline: content.home.hero.headline,
  responseTime: content.contact.responseTime,
  socials: socialLinks,
  projects: content.projects.items.map(({ name, summary, linkPreview, linkSource }) => ({
    name,
    summary: fillVariables(summary, locale),
    url: linkPreview || linkSource || "",
  })),
  skills: content.skills.items,
  experience: content.experience.items.map(({ company, position, startDate, endDate }) => ({
    company,
    position,
    period: `${startDate} → ${endDate}`,
  })),
  education: content.education.items.map(({ degree, school }) => ({ degree, school })),
  services: content.services.items.map((s) => ({
    title: s.title,
    price:
      (s.priceFrom && s.price != null ? `${ui.price.from} ` : "") +
      formatPrice(s.price, locale) +
      (s.priceSuffix && s.price != null ? ` ${s.priceSuffix}` : ""),
  })),
  fx: ui.fx,
  terminal: ui.terminal,
};
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="author" content={author} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#070708" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalURL} />
    {
      LOCALES.map((l) => (
        <link rel="alternate" hreflang={l} href={getAbsoluteLocaleUrl(l, "")} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={getAbsoluteLocaleUrl(DEFAULT_LOCALE, "")} />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&family=Manrope:wght@400;500;600;700&family=Syne:wght@400..800&display=swap"
      rel="stylesheet"
    />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale === "fr" ? "fr_FR" : "en_US"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImgUrl} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImgUrl} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="is-loading">
    <!-- Preloader -->
    <div class="loader" id="loader" aria-hidden="true">
      <div class="loader__inner">
        <div class="loader__log mono" id="loaderLog"></div>
        <div class="loader__bottom">
          <span class="mono">{name}<br />{ui.fx.portfolio} ©{new Date().getFullYear()}</span>
          <span class="loader__count" id="loaderCount">000</span>
        </div>
        <div class="loader__bar"><span id="loaderBar"></span></div>
      </div>
    </div>

    <!-- Calques globaux -->
    <canvas id="webgl" aria-hidden="true"></canvas>
    <div class="vignette" aria-hidden="true"></div>
    <div class="grain" aria-hidden="true"></div>
    <div class="progress" aria-hidden="true"><span id="progress"></span></div>
    <div class="cursor" aria-hidden="true">
      <div class="cursor__dot"></div>
      <div class="cursor__ring"><span class="cursor__label"></span></div>
    </div>

    <Header locale={locale} />

    <main>
      <slot />
    </main>

    <div class="toast mono" id="toast" role="status" aria-live="polite"></div>

    <script is:inline type="application/json" id="site-data" set:html={JSON.stringify(siteData)} />
    <script>
      import "../scripts/main.js";
    </script>
  </body>
</html>
