---
// Parcours : expériences (timeline) + diplômes
import SectionLabel from "./SectionLabel.astro";
import Heading from "./Heading.astro";
import { getContent, getUi } from "@i18n";
import type { Locale } from "@types";

interface Props {
  locale: Locale;
  num: number;
}

const { locale, num } = Astro.props;
const { experience, education } = getContent(locale);
const t = getUi(locale).fx;
---

<section class="journey" id="experience" data-scene="journey">
  <div class="journey__head">
    <SectionLabel num={num} text={experience.title} />
    <Heading lines={t.journeyHeading} />
  </div>

  <div class="journey__list">
    <div class="journey__line"><span></span></div>

    {
      experience.items.map((job) => (
        <article class="job">
          <div class="job__date mono">
            {job.startDate} — {job.endDate}
          </div>
          <h3 class="job__company">{job.company}</h3>
          <p class="job__role">{job.position}</p>
          <ul class="job__list">
            {job.highlights.map((h) => (
              <li>{h}</li>
            ))}
          </ul>
        </article>
      ))
    }

    <h3 class="edu__title mono">{education.title}</h3>
    <div class="edu">
      {
        education.items.map((e) => (
          <div class="edu__item">
            <span class="mono">
              {e.startDate} — {e.endDate}
            </span>
            <b>{e.degree}</b>
            <small>{e.school}</small>
            {e.summary && <p>{e.summary}</p>}
          </div>
        ))
      }
    </div>
  </div>
</section>
