---
import Section from "./Section.astro";
import type { ExperienceContent } from "@types";

type Props = ExperienceContent;

const { title, items } = Astro.props;
---

<Section text={title} href="experience">
  {
    items.map(({ company, position, startDate, endDate, highlights }) => (
      <div class="mb-10">
        <h3 class="mb-1.5 font-serif text-2xl font-semibold text-white">
          {company}
        </h3>
        <div class="flex flex-col items-start pb-5">
          <h4 class="mb-0.5 font-serif text-2xl font-medium text-primary">
            {position}
          </h4>
          <span class="pb-0.5 text-sm text-white/70">
            {startDate} — {endDate}
          </span>
        </div>
        {highlights.length > 1 ? (
          <ul class="list-none">
            {highlights.map((log) => (
              <li class="relative mb-3 pl-8 text-base text-neutral before:absolute before:top-1 before:left-0 before:content-[url(/check.svg)]">
                {log}
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-base text-neutral">{highlights[0]}</p>
        )}
      </div>
    ))
  }
</Section>
