---
// Formations & ressources : lignes qui se remplissent au survol
import SectionLabel from "./SectionLabel.astro";
import Heading from "./Heading.astro";
import { settings, getContent, getUi } from "@i18n";
import { formatPrice, whatsappLink } from "@lib/format";
import type { Locale } from "@types";

interface Props {
  locale: Locale;
  num: number;
}

const { locale, num } = Astro.props;
const { title, intro, items } = getContent(locale).resources;
const ui = getUi(locale);
const t = ui.resources;

// Offre disponible avec lien → lien de paiement/détail ; sinon → WhatsApp (liste d'attente)
const ctaHref = (item: (typeof items)[number]) =>
  item.status === "available" && item.link ? item.link : whatsappLink(item.whatsappMessage);

const newsletter = settings.socialLinks.find((s) => /substack|newsletter/i.test(s.href + s.text));
---

<section class="academy" id="resources" data-scene="academy">
  <SectionLabel num={num} text={title} />
  <Heading lines={ui.fx.resourcesHeading} />
  <p class="section-intro">{intro}</p>

  <ul class="academy__list">
    {
      items.map((item) => (
        <li>
          <a class="academy__row" href={ctaHref(item)} target="_blank" rel="noopener" data-cursor={item.cta}>
            <span class="mono academy__type">{t.types[item.type] ?? item.type}</span>
            <span class="academy__title">{item.title}</span>
            <span class="academy__desc">{item.description}</span>
            <span class="academy__tag mono">
              {item.status === "available"
                ? typeof item.price === "number"
                  ? formatPrice(item.price, locale)
                  : item.cta
                : t.soon}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
  {
    newsletter && (
      <a class="btn btn--ghost" href={newsletter.href} target="_blank" rel="noopener" data-magnetic="0.25">
        {ui.fx.newsletter} <span class="btn__arrow">↗</span>
      </a>
    )
  }
</section>
