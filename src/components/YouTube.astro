---
import SectionLabel from "./SectionLabel.astro";
import { settings, getContent, getUi } from "@i18n";
import { formatDate, formatSubscribers } from "@lib/format";
import { getLatestVideos } from "@lib/youtube";
import type { Locale } from "@types";

interface Props {
  locale: Locale;
  num: number;
}

const { locale, num } = Astro.props;
const { title, intro } = getContent(locale).youtube;
const ui = getUi(locale);
const t = ui.youtube;
const { url: channelUrl, channelId } = settings.youtube;
const videos = await getLatestVideos(channelId, 3);
---

<section class="yt" id="youtube" data-scene="youtube">
  <div class="yt__head">
    <div>
      <SectionLabel num={num} text="YouTube" />
      <h2 class="h2 yt__title"><span class="ln"><span>{title}</span></span></h2>
      <p class="section-intro">{intro}</p>
    </div>
    <div class="yt__subs">
      <span class="yt__subs-num">{formatSubscribers(locale)}</span>
      <span class="mono">{getContent(locale).home.proofs.subscribersLabel}</span>
    </div>
  </div>

  {
    videos.length > 0 ? (
      <div class="yt__grid">
        {videos.map((video) => (
          <article class="video">
            {/* Miniature cliquable : l'iframe YouTube n'est chargée qu'au clic (performance) */}
            <div class="video__media">
              <button
                type="button"
                class="yt-lite"
                data-video-id={video.id}
                data-video-title={video.title}
                data-cursor={ui.fx.watch}
                aria-label={`${t.play} : ${video.title}`}
              >
                <img src={video.thumbnail} alt="" width="480" height="360" loading="lazy" decoding="async" />
                <span class="video__play" aria-hidden="true"></span>
              </button>
            </div>
            <div class="video__body">
              <time class="mono" datetime={video.published.toISOString()}>
                {formatDate(video.published, locale)}
              </time>
              <h3>{video.title}</h3>
              <a href={video.url} target="_blank" rel="noopener">
                {t.watch} ↗
              </a>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <p class="section-intro">{t.unavailable}</p>
    )
  }

  <div class="yt__ctas">
    <a class="btn btn--accent" href={channelUrl} target="_blank" rel="noopener" data-magnetic="0.25">
      {t.allVideos} <span class="btn__arrow">↗</span>
    </a>
    <a class="btn btn--ghost" href={`${channelUrl}?sub_confirmation=1`} target="_blank" rel="noopener" data-magnetic="0.25">
      {t.subscribe} <span class="btn__arrow">↗</span>
    </a>
  </div>
</section>
