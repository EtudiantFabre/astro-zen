---
import Section from "./Section.astro";
import type { SkillsContent } from "@types";

type Props = SkillsContent;

const { title, items } = Astro.props;
---

<Section text={title} href="skills">
  <div class="flex flex-col gap-8">
    {
      items.map(({ category, items }) => (
        <div>
          <h3 class="mb-4 font-serif text-xl font-semibold text-white">
            {category}
          </h3>
          <ul class="flex flex-wrap gap-3">
            {items.map((item) => (
              <li class="rounded-full border border-neutral/25 bg-[#1c232d]/85 px-4 py-2 text-sm text-neutral">
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</Section>
