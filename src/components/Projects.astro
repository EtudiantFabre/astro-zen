---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import type { ProjectProps } from "@types";

interface Props {
  projects: ProjectProps[];
}

const { projects } = Astro.props;
---

<Section text="Projets" href="projects">
  {
    projects.map(({ name, summary, image, linkPreview, linkSource }, index) => {
      const top = 98 + index * 40;
      return (
        <div
          style={`top: ${top}px;`}
          class="sticky mb-12 rounded-2xl border border-neutral/20 bg-black"
        >
          <div class="bg-difu relative z-1 grid min-h-145 w-full grid-rows-2 rounded-2xl bg-[#1c232d]/85 sm:grid-cols-2 sm:grid-rows-1 md:min-h-96">
            <div class="flex flex-col px-6 pt-12 pb-8">
              <h3 class="mb-5 font-serif text-3xl font-medium text-primary">
                {name}
              </h3>
              <p class="text-base text-neutral">{summary}</p>
              <div class="mt-auto flex gap-5 pt-8 text-white">
                {
                  linkSource && (
                    <a
                      href={linkSource}
                      target="_blank"
                      class="after:relative after:-bottom-1.25 after:content-[url(/external.svg)] hover:underline"
                    >
                      Code source
                    </a>
                  )
                }
                {
                  linkPreview && (
                    <a
                      href={linkPreview}
                      target="_blank"
                      class="after:relative after:-bottom-1.25 after:content-[url(/external.svg)] hover:underline"
                    >
                      Aperçu
                    </a>
                  )
                }
              </div>
            </div>
            <div class="flex items-end justify-end overflow-hidden">
              <Image
                class="h-full w-[95%] rounded-ss-xl rounded-ee-2xl object-none object-top-left sm:h-[85%] sm:w-full"
                src={image}
                alt={name}
                width="736"
                height="483"
              />
            </div>
          </div>
        </div>
      );
    })
  }
</Section>
