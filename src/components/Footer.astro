---
import { settings, getUi } from "@i18n";
import type { Locale } from "@types";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getUi(locale);
---

<footer class="footer">
  <div class="footer__giant" aria-hidden="true">{settings.name.toUpperCase()}</div>
  <div class="footer__row mono">
    <span>© {new Date().getFullYear()} {settings.author} — {t.fx.madeIn}. {t.footer.rights}</span>
    <span class="hide-sm" set:html={t.fx.easterHint} />
    <a href="#top" data-scramble>{t.fx.backToTop}</a>
  </div>
</footer>
