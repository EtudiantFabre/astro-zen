---
import { settings, getUi } from "@i18n";
import type { Locale } from "@types";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { author, socialLinks } = settings;
const t = getUi(locale);
const currentYear = new Date().getFullYear();
---

<footer
  class="w-full border-t border-neutral/20 px-5 pt-5 pb-8 text-center text-white"
>
  <ul class="mb-5 flex flex-wrap justify-center gap-x-5 text-xs">
    {
      socialLinks.map(({ text, href }) => (
        <li>
          <a
            href={href}
            target="_blank"
            rel="noopener"
            class="inline-block px-4 py-3 after:relative after:-bottom-1 after:content-[url(/external.svg)] hover:text-primary"
          >
            {text}
          </a>
        </li>
      ))
    }
  </ul>
  <p class="text-xs">
    {author} © {currentYear}. {t.footer.rights}
  </p>
</footer>
