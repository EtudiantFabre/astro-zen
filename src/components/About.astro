---
import Section from "./Section.astro";
import { Image } from "astro:assets";
import { settings, getContent } from "@i18n";
import { fillVariables } from "@lib/format";
import type { Locale } from "@types";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { title, description, image } = getContent(locale).about;
const paragraphs = fillVariables(description, locale)
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter(Boolean);
---

<Section text={title} href="about">
  <div class="flex flex-col items-center gap-12 md:flex-row md:gap-8">
    <div class="w-auto space-y-5 text-base text-neutral md:pr-5">
      {paragraphs.map((p) => <p>{p}</p>)}
    </div>
    <div class="h-80 w-64 shrink-0 rotate-[5deg] bg-white p-4 md:rotate-[7deg]">
      <Image
        class="object-cover"
        src={image}
        width="260"
        height="260"
        alt={settings.name}
      />
    </div>
  </div>
</Section>
