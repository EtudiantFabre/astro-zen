---
// Page d'accueil commune aux deux langues (src/pages/index.astro et src/pages/en/index.astro)
import Layout from "@layouts/Layout.astro";
import Hero from "./Hero.astro";
import About from "./About.astro";
import Projects from "./Projects.astro";
import Skills from "./Skills.astro";
import Experience from "./Experience.astro";
import Services from "./Services.astro";
import Resources from "./Resources.astro";
import YouTube from "./YouTube.astro";
import Contact from "./Contact.astro";
import type { Locale } from "@types";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
---

<Layout locale={locale}>
  <Hero locale={locale} />
  <About locale={locale} num={1} />
  <Projects locale={locale} num={2} />
  <Skills locale={locale} num={3} />
  <Experience locale={locale} num={4} />
  <Services locale={locale} num={5} />
  <Resources locale={locale} num={6} />
  <YouTube locale={locale} num={7} />
  <Contact locale={locale} num={8} />
</Layout>
