---
import { settings, getContent, getUi } from "@i18n";
import { whatsappLink } from "@lib/format";
import type { Locale } from "@types";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { hero } = getContent(locale).home;
const t = getUi(locale).fx;

// Le nom affiché (Réglages) est découpé en deux lignes géantes
const words = settings.name.trim().split(/\s+/);
const first = words.slice(0, Math.ceil(words.length / 2)).join(" ");
const second = words.slice(Math.ceil(words.length / 2)).join(" ");
---

<section class="hero" id="top" data-scene="hero">
  <div class="hero__meta mono">
    <span>({t.portfolio} — ©{new Date().getFullYear()})</span>
    <span class="hide-sm">{hero.specialty}</span>
    <span>{t.coords}</span>
  </div>

  <h1 class="hero__title" aria-label={settings.name}>
    <span class="hero__line" data-split-chars>{first}</span>
    {
      second && (
        <span class="hero__line hero__line--2">
          <em class="hero__tag" set:html={t.heroTag} />
          <span data-split-chars>{second}</span>
        </span>
      )
    }
  </h1>

  <div class="hero__bottom">
    <div class="hero__text">
      <p class="hero__lead">
        {t.rotatorPrefix} <span class="rotator" id="rotator">{t.rotator[0]}</span>
      </p>
      <p class="hero__summary"><strong>{hero.headline}</strong> {hero.summary}</p>
    </div>
    <div class="hero__ctas">
      <a class="btn btn--accent" href="#services" data-magnetic="0.25">{hero.primaryCta} <span class="btn__arrow">↓</span></a>
      <a class="btn btn--ghost" href={whatsappLink(hero.whatsappMessage)} target="_blank" rel="noopener" data-magnetic="0.25">
        {hero.secondaryCta} <span class="btn__arrow">↗</span>
      </a>
    </div>
    <a href="#about" class="hero__scroll" data-magnetic="0.4" data-cursor="Go" aria-label="Scroll">
      <svg viewBox="0 0 120 120" class="hero__circle" aria-hidden="true">
        <defs><path id="circ" d="M60,60 m-46,0 a46,46 0 1,1 92,0 a46,46 0 1,1 -92,0"></path></defs>
        <text><textPath href="#circ" textLength="286" lengthAdjust="spacing">{t.scroll}</textPath></text>
      </svg>
      <span class="hero__arrow">↓</span>
    </a>
  </div>
</section>
