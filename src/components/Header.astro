---
import { getRelativeLocaleUrl } from "astro:i18n";
import { LOCALES, settings, getUi } from "@i18n";
import type { Locale } from "@types";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getUi(locale);

const navLinks = [
  { text: t.nav.projects, href: "#projects" },
  { text: t.nav.services, href: "#services" },
  { text: t.nav.resources, href: "#resources" },
  { text: t.nav.youtube, href: "#youtube" },
  { text: t.nav.contact, href: "#contact" },
];

const initials = settings.name
  .split(/\s+/)
  .map((w) => w[0])
  .join("")
  .slice(0, 2)
  .toUpperCase();
---

<header class="nav" id="nav">
  <a href="#top" class="nav__logo" data-magnetic="0.3" aria-label={t.header.homeLink}>
    <span class="nav__mark">{initials}</span>
    <span class="nav__name mono">{settings.name}</span>
  </a>
  <nav class="nav__links" aria-label={t.header.homeLink}>
    {navLinks.map((l) => <a href={l.href} data-scramble>{l.text}</a>)}
  </nav>
  <div class="nav__right">
    <div class="nav__status mono">
      <span class="pulse"></span>{t.fx.available} · Lomé <span id="clock">--:--:--</span>
    </div>
    <div class="lang mono" role="group" aria-label={t.header.switchLanguage}>
      {
        LOCALES.map((l) => (
          <a
            href={getRelativeLocaleUrl(l, "")}
            hreflang={l}
            lang={l}
            aria-current={l === locale ? "true" : undefined}
            class:list={[l === locale && "is-active"]}
            data-no-smooth
          >
            {l}
          </a>
        ))
      }
    </div>
    <button class="nav__burger" id="burger" aria-label={t.header.openMenu} aria-expanded="false" aria-controls="menu">
      <span></span><span></span>
    </button>
  </div>
</header>

<div class="menu" id="menu" aria-hidden="true">
  <nav class="menu__links">
    {
      navLinks.map((l, i) => (
        <a href={l.href}>
          <span class="mono">{String(i + 1).padStart(2, "0")}</span>
          {l.text}
        </a>
      ))
    }
  </nav>
  <div class="menu__foot mono">{settings.email}<br />{settings.phone}</div>
</div>
