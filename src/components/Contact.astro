---
import SectionLabel from "./SectionLabel.astro";
import Heading from "./Heading.astro";
import Footer from "./Footer.astro";
import { settings, getContent, getUi } from "@i18n";
import { whatsappLink } from "@lib/format";
import type { Locale } from "@types";

interface Props {
  locale: Locale;
  num: number;
}

const { locale, num } = Astro.props;
const content = getContent(locale);
const { title, intro, responseTime } = content.contact;
const ui = getUi(locale);
const t = ui.contact;
const { email, phone, whatsapp, socialLinks } = settings;

const subjects = [...content.services.items.map((s) => s.title), t.subjectOther];
---

<section class="contact" id="contact" data-scene="contact">
  <SectionLabel num={num} text={title} />
  <Heading lines={ui.fx.contactHeading} class="contact__title" />

  <div class="contact__grid">
    <div class="contact__actions">
      <p class="section-intro">{intro}</p>
      <button class="contact__email" id="copyEmail" data-cursor={ui.fx.copy} data-email={email}>
        {email}
      </button>
      <div class="contact__btns">
        <a class="btn btn--accent" href={whatsappLink(content.home.hero.whatsappMessage)} target="_blank" rel="noopener" data-magnetic="0.3">
          {t.whatsapp} · {phone} <span class="btn__arrow">↗</span>
        </a>
        <a class="btn btn--ghost" href={`mailto:${email}`} data-magnetic="0.3">
          {t.email} <span class="btn__arrow">↗</span>
        </a>
      </div>
      <p class="contact__note mono"><span class="pulse"></span>{responseTime}</p>
    </div>

    <form
      id="contact-form"
      class="form"
      data-email={email}
      data-whatsapp={whatsapp}
      data-greeting={t.greeting}
      data-signature={t.signature}
    >
      <h3 class="form__title">{t.formTitle}</h3>
      <div class="form__row">
        <label class="field">
          <span class="mono">{t.name}</span>
          <input name="name" type="text" required autocomplete="name" />
        </label>
        <label class="field">
          <span class="mono">{t.emailField}</span>
          <input name="email" type="email" required autocomplete="email" />
        </label>
      </div>
      <label class="field">
        <span class="mono">{t.subject}</span>
        <select name="subject">
          {subjects.map((s) => <option>{s}</option>)}
        </select>
      </label>
      <label class="field">
        <span class="mono">{t.message}</span>
        <textarea name="message" rows="4" required placeholder={t.messagePlaceholder}></textarea>
      </label>
      <div class="form__btns">
        <button type="submit" value="whatsapp" class="btn btn--accent">{t.sendWhatsapp}</button>
        <button type="submit" value="email" class="btn btn--ghost">{t.sendEmail}</button>
      </div>
      <p class="form__hint mono">{t.formHint}</p>
    </form>
  </div>

  <ul class="socials">
    {
      socialLinks.map(({ text, href }, i) => (
        <li>
          <a href={href} target="_blank" rel="noopener" data-cursor="↗">
            <span class="mono">{String(i + 1).padStart(2, "0")}</span>
            {text}
          </a>
        </li>
      ))
    }
  </ul>

  <Footer locale={locale} />
</section>
