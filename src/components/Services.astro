---
import Section from "./Section.astro";
import { getContent, getUi } from "@i18n";
import { formatPrice, whatsappLink } from "@lib/format";
import type { Locale } from "@types";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { title, intro, items, note } = getContent(locale).services;
const t = getUi(locale).price;
---

<Section text={title} href="services" intro={intro}>
  <div class="grid gap-6 sm:grid-cols-2">
    {
      items.map((service) => (
        <article
          class:list={[
            "relative flex flex-col rounded-2xl border bg-[#1c232d]/85 px-6 pt-8 pb-6",
            service.featured ? "border-primary" : "border-neutral/20",
          ]}
        >
          {service.featured && (
            <span class="absolute -top-3 left-6 rounded-full bg-primary px-3 py-1 text-xs font-medium text-[#fff]">
              {t.popular}
            </span>
          )}
          <h3 class="mb-3 font-serif text-2xl font-semibold text-white">
            {service.title}
          </h3>
          <p class="mb-5 text-base text-neutral">{service.description}</p>

          {service.points && service.points.length > 0 && (
            <ul class="mb-6 list-none">
              {service.points.map((point) => (
                <li class="relative mb-2 pl-8 text-sm text-neutral before:absolute before:top-0.5 before:left-0 before:content-[url(/check.svg)]">
                  {point}
                </li>
              ))}
            </ul>
          )}

          <div class="mt-auto">
            <p class="mb-5">
              {service.priceFrom && service.price != null && (
                <span class="block text-xs text-neutral">{t.from}</span>
              )}
              <span class="font-serif text-3xl font-bold text-primary">
                {formatPrice(service.price, locale)}
              </span>
              {service.priceSuffix && service.price != null && (
                <span class="text-sm text-neutral"> {service.priceSuffix}</span>
              )}
            </p>
            <a
              href={whatsappLink(service.whatsappMessage)}
              target="_blank"
              rel="noopener"
              class:list={[
                "block rounded-full px-6 py-4 text-center text-sm font-medium transition-opacity hover:opacity-90",
                service.featured
                  ? "bg-primary text-[#fff]"
                  : "border border-primary text-white hover:bg-primary",
              ]}
            >
              {service.cta}
            </a>
          </div>
        </article>
      ))
    }
  </div>
  {note && <p class="mt-8 text-sm text-neutral">{note}</p>}
</Section>
