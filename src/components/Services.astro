---
import SectionLabel from "./SectionLabel.astro";
import Heading from "./Heading.astro";
import { getContent, getUi } from "@i18n";
import { formatPrice, whatsappLink } from "@lib/format";
import type { Locale } from "@types";

interface Props {
  locale: Locale;
  num: number;
}

const { locale, num } = Astro.props;
const { title, intro, items, note } = getContent(locale).services;
const ui = getUi(locale);
const t = ui.price;
---

<section class="services" id="services" data-scene="services">
  <div class="services__head">
    <SectionLabel num={num} text={title} />
    <Heading lines={ui.fx.servicesHeading} />
    <p class="section-intro">{intro}</p>
  </div>

  <div class="services__grid">
    {
      items.map((s, i) => (
        <article class:list={["service", s.featured && "is-featured"]} data-spotlight>
          <div class="service__top">
            <span class="mono service__num">{String(i + 1).padStart(2, "0")}</span>
            {s.featured && <span class="service__badge mono">{t.popular}</span>}
          </div>
          <h3 class="service__title">{s.title}</h3>
          <p class="service__price">
            {s.priceFrom && s.price != null && <small>{t.from} </small>}
            {formatPrice(s.price, locale)}
            {s.priceSuffix && s.price != null && <small> {s.priceSuffix}</small>}
          </p>
          <p class="service__desc">{s.description}</p>
          {s.points && s.points.length > 0 && (
            <ul class="service__list">
              {s.points.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
          )}
          <a class="service__cta" href={whatsappLink(s.whatsappMessage)} target="_blank" rel="noopener">
            {s.cta} <span>→</span>
          </a>
        </article>
      ))
    }
  </div>
  {note && <p class="services__note mono">{note}</p>}
</section>
